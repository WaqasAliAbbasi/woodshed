{
    # https://caddyserver.com/docs/caddyfile/options#global-options
    auto_https off
}

:80 {
    # Serve the built SPA.
    root * /usr/share/caddy

    # zstd first (modern browsers prefer it), gzip as the fallback. Caddy adds
    # the Vary header and skips pre-compressed responses itself, so proxied
    # requests through traefik compress correctly.
    encode zstd gzip

    # Vite emits hashed asset filenames, so cache them hard.
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # SPA fallback: no client-side routing today, but cheap insurance that a
    # deep link resolves to index.html rather than a 404.
    try_files {path} /index.html

    file_server
}